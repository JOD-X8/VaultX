# ==============================================================================
# VaultX Environment Configuration
# ==============================================================================

# Neon PostgreSQL Connection String (Pooled connection recommended for serverless/Vercel)
# Example: postgresql://username:password@ep-cool-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@endpoint-pooler.neon.tech/neondb?sslmode=require"

# Direct Neon Connection String (Optional, for direct migrations if unpooled is needed)
DATABASE_URL_UNPOOLED="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Master Secret / JWT Secret for Server Session Verification
SESSION_SECRET="your-32-character-random-session-secret-here"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
